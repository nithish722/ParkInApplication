<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_liquid_aura">

    <!-- Top Admin Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#160B1232">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ ⛶ ] CrissCross"
            android:textColor="#E8B86D"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_active"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="ADMIN CONSOLE"
            android:textColor="#E8B86D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_pill_inactive"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Administrator"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnAdminLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_nav_pill_inactive"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Logout"
            android:textColor="#F16E68"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Horizontal Liquid Dock Navigation for Admin -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/adminDockLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/adminNavDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nav_pill_active"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="📊 Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adminNavEvents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="📅 Events"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/adminNavAreas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="🏢 Areas"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/adminNavSlots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="🅿 Slots"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/adminNavStatusMonitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="⚡ Status Monitor"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/adminNavBookings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="📋 Bookings"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/adminNavUsers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="👥 Users"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/adminNavAnnouncements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="📢 Announcements"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/adminNavReports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="📈 Reports"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Dynamic Section Container -->
    <FrameLayout
        android:id="@+id/adminContentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>