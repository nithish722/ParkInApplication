<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvSlotIdentifier"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="SJT-C01"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSlotZoneType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SJT PARKING | CAR"
            android:textColor="#F16E68"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSlotLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ground Level"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSlotCurrentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_active"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="AVAILABLE"
        android:textColor="#E8B86D"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDeleteSlot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_nav_pill_inactive"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Delete"
        android:textColor="#EF4444"
        android:textSize="11sp" />
</LinearLayout>