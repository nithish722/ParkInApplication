<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_liquid_aura">

    <!-- Top Universal Glass Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#160B1232">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ ⛶ ] CrissCross"
            android:textColor="#E8B86D"
            android:textStyle="bold"
            android:textSize="18sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- User Profile Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_pill_inactive"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvHeaderUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alex Reynolds"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Logout Action Button -->
        <TextView
            android:id="@+id/btnHeaderLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_nav_pill_inactive"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Logout"
            android:textColor="#F16E68"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Horizontal Liquid Dock Navigation Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dockLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nav_pill_active"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="📊 Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navCampusEvents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="📅 Campus Events"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/navSmartRecommender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="🧠 Smart Recommender"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/navParkingMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="🗺 Parking Map"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/navReservations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="🎟 My Passes"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/navAnnouncements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="📢 Announcements"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/navProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="👤 Profile"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/navHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="ℹ Help &amp; About"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Dynamic Section Container -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>