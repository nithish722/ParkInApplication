<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Pass Header Badge -->
    <TextView
        android:id="@+id/tvDialogPassBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_active"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="CRISS-2026-X892"
        android:textColor="#E8B86D"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogEventTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Annual Tech Innovation Symposium 2026"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogPassSubDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Zone: SJT PARKING  |  Slot: SJT-C01  |  Plate: TN-22-CR-1024"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <!-- QR Code Image Container -->
    <LinearLayout
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_marginTop="14dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:padding="10dp">

        <ImageView
            android:id="@+id/ivPassQrCode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Scannable Gate QR Pass Code" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Official Gate Barrier Pass • Scan at Gate"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <!-- Download PDF & Close Buttons -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDownloadPdfPass"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_cyber_gradient"
        android:text="📥 Download PDF Pass"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnCloseQrDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_nav_pill_inactive"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:text="Close"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />
</LinearLayout>