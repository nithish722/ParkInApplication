<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPassBookingCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRISS-2026-X892"
            android:textColor="#E8B86D"
            android:textStyle="bold"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPassStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_pill_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="CONFIRMED"
            android:textColor="#E8B86D"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPassEventTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Annual Tech Innovation Symposium 2026"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPassDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Zone: SJT PARKING  |  Slot: SJT-C06  |  Vehicle: TN-22-CR-1024"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_pill_inactive"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Cancel Pass"
            android:textColor="#EF4444"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnViewQrPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_nav_pill_inactive"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="View Pass"
            android:textColor="#F16E68"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>