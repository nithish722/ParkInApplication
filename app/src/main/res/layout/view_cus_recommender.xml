<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CrissCross Smart Parking Recommendation"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Calculates optimal walking distance &amp; availability based on event venue."
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- Parameters Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Campus Event"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spRecommenderEvent"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_input" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Vehicle Mode"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgVehicleMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🚗 Four Wheeler (Car)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbBike"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="🏍 Two Wheeler (Bike)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Top Recommended Area Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_nav_pill_inactive"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="TOP RECOMMENDED PARKING AREA"
                    android:textColor="#E8B86D"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_nav_pill_inactive"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:text="99% Match Score"
                    android:textColor="#F16E68"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRecAreaName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="P [ ] SJT PARKING"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRecAreaDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Directly Servicing: SJT Auditorium (50m • ~1 min walk)"
                android:textColor="#E8B86D"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChooseRecSlot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_cyber_gradient"
                android:text="Choose Slot in SJT PARKING →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>